{
  "name": "@weareikko/changelog",
  "version": "0.1.0",
  "description": "Validate .changelog/ fragments on pull and merge requests and fold them into CHANGELOG.md at release time, on GitHub Actions and GitLab CI.",
  "keywords": [
    "changelog",
    "fragments",
    "github-action",
    "gitlab-ci",
    "keep-a-changelog"
  ],
  "homepage": "https://github.com/weareikko/changelog#readme",
  "bugs": {
    "url": "https://github.com/weareikko/changelog/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weareikko/changelog.git"
  },
  "bin": {
    "changelog": "./bin/changelog.js"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsgo --emitDeclarationOnly",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.test.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build && npm pack --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/semver": "^7.8.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,json,md,yml,yaml}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  }
}
